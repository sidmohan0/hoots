# Model endpoint: any OpenAI-compatible chat completions API
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...

# Telegram channel (create via @BotFather). Leave empty to disable.
TELEGRAM_BOT_TOKEN=

# Perch (daemon) settings
PERCH_PORT=7420
PERCH_DATA_DIR=~/.hoots
PERCH_AUTH_TOKEN=change-me-long-random-string

# iMessage channel (macOS only; needs Automation + Full Disk Access for the
# terminal that runs the perch). Both must be set before the herald starts.
PERCH_IMESSAGE=false
PERCH_IMESSAGE_BUDDY=

# Nightly autonomous pass over every active hoot at 03:00 local.
PERCH_NIGHT_FLIGHT=false
