# Model endpoint: any OpenAI-compatible chat completions API
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...

# Telegram channel (create via @BotFather). Leave empty to disable.
TELEGRAM_BOT_TOKEN=

# Perch (daemon) settings
PERCH_PORT=7420
PERCH_DATA_DIR=~/.hoots
PERCH_AUTH_TOKEN=change-me-long-random-string

# Ops knobs (all optional)
PERCH_RATE_LIMIT=30          # POSTs/minute per IP+route family; 0 disables
PERCH_LOG_FILE=              # also append JSON logs here (5 MB rotation, 3 kept)
PERCH_LOG_LEVEL=info         # debug | info | warn | error
HOOTS_WEBHOOK_SECRET=        # signs webhook POSTs (x-hoots-signature)
