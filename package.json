{
  "name": "hoots",
  "private": true,
  "version": "0.0.1",
  "description": "Always-on personal agents",
  "license": "MIT",
  "workspaces": [
    "perch",
    "parliament",
    "desktop"
  ],
  "scripts": {
    "dev": "npm run dev -w perch",
    "build": "npm run build -w perch",
    "test": "vitest run",
    "lint": "oxlint perch/src perch/test parliament/src",
    "typecheck": "npm run typecheck -w perch && npm run typecheck -w parliament",
    "desktop": "npm run build -w @hoots/desktop"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "oxlint": "^1.93.0",
    "vitest": "^3.2.7"
  }
}